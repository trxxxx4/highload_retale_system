REGISTRY=ghcr.io/your-github-username
TAG=latest

POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin_password

AUTH_DB=authdb
APP_DB=inventorydb

AUTH_USER=auth_user
AUTH_PASSWORD=auth_password

DB_USER=db_user
DB_PASSWORD=db_password

AUTH_CONNECT=postgres://auth_user:auth_password@postgres:5432/authdb?sslmode=disable
DB_CONNECT=postgres://db_user:db_password@postgres:5432/inventorydb?sslmode=disable

AUTH_PORT=:8081
DB_PORT=:8080
INVENTORY_PORT=:8082

REDIS_ADDR=redis:6379
REDIS_PASSWORD=redis_password

DBSERVICE_URL=http://dbservice:8080

JWT_SECRET=change_me_to_a_long_random_secret
JWT_ISSUER=inventory-auth
JWT_TTL=60m